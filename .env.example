# ==============================================================================
# STΔN Studio — Frontend Environment Variables Template (Vercel & CI/CD)
# Copy these keys into your Vercel Project Settings > Environment Variables
# Server-side secrets live in server/.env.example (never commit real values)
# ==============================================================================

# Supabase Project URL (Public)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable / Anon Key (Public / Client Safe)
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Dedicated order backend (server/ deployment URL) — orders/mail admin API
VITE_API_BASE=https://your-backend.onrender.com

# Admin panel passkey (also used as the backend ADMIN_SECRET_KEY)
VITE_ADMIN_PASSKEY=stan-admin-2026

# Mail (IMAP/SMTP) is configured on the SERVER only — see server/.env.example
# for IMAP_HOST / IMAP_PORT / SMTP_HOST / SMTP_PORT / MAIL_USER / MAIL_PASS.
