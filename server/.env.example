# ── STΔN studio. server environment ──────────────────────────────────────────
# Supabase project (service role — SERVER ONLY, never expose to the client)
SUPABASE_URL=https://imeravcrrnfmigwzqjzl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin API key — must match the passkey entered in the /admin panel
# (the frontend reads VITE_ADMIN_PASSKEY; default for local dev: stan-admin-2026)
ADMIN_SECRET_KEY=stan-admin-2026

# Port (Render/Railway inject their own PORT)
PORT=8787

# Comma-separated origins allowed to call the API (your Vercel domain + localhost)
ALLOWED_ORIGIN=http://localhost:5173,https://stan-studio.vercel.app

# ─── Titan Mail (Name.com) — IMAP/SMTP ───
IMAP_HOST=imap.titan.email
IMAP_PORT=993
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
MAIL_USER=stanstudio@example.dev
MAIL_PASS=your-mailbox-password
